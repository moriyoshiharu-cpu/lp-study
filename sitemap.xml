<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml
  ==========================================================================
  「このサイトにはこういうページがあります」という目次を、検索エンジンに渡す
  ためのファイル。Google がリンクを辿って自力で見つけるのを待たずに、
  こちらから一覧を提出できます。

  【効果が大きいケース】
    ・公開したばかりでリンクが1本もないサイト（＝まさに今回）
    ・ページ数が非常に多いサイト
    ・トップからリンクが辿れない孤立ページがある場合

  【誤解しやすい点】
    sitemap.xml に載せても「順位が上がる」わけではありません。
    上がるのは「見つけてもらえる確率」と「見つかるまでの速さ」だけです。

  【タグの意味】
    loc        必須。ページのURL（絶対URLで書く）
    lastmod    最終更新日。更新したら必ず直す（嘘を書くと信用を失う）
    changefreq 更新頻度の目安。あくまで参考情報として扱われる
    priority   サイト内での相対的な重要度（0.0〜1.0）。他サイトとの比較ではない
  ==========================================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://moriyoshiharu-cpu.github.io/lp-study/</loc>
    <lastmod>2026-08-12</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
